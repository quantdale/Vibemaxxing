{
  "name": "tote",
  "productName": "Tote",
  "version": "0.3.0",
  "description": "One window for all your LLMs - web apps, native apps and CLI agents organized around workspaces.",
  "main": "src/main/main.js",
  "license": "MIT",
  "author": "quantdale",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node scripts/copy-vendor.js",
    "start": "electron .",
    "test": "node scripts/test-layout.js && node scripts/test-scratch.js && node scripts/test-config.js && node scripts/test-ptybatch.js && node scripts/test-syscheck.js && node scripts/test-store.js && node scripts/test-containment.js",
    "doctor": "node scripts/doctor.js",
    "predist:win": "node scripts/win-sign-cache.js",
    "smoke:pty": "node scripts/smoke-pty.js",
    "test:e2e": "node scripts/test-e2e.js",
    "smoke:packaged": "node scripts/smoke-packaged.js",
    "bench": "node scripts/bench.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.tote.app",
    "productName": "Tote",
    "electronVersion": "37.10.3",
    "npmRebuild": false,
    "files": [
      "src/**/*",
      "config/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "synopsis": "One window for all your LLMs"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "asarUnpack": [
      "node_modules/node-pty/**"
    ]
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "chokidar": "^4.0.1",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "electron": "37.10.3",
    "electron-builder": "25.1.8",
    "playwright-core": "^1.62.1"
  }
}
